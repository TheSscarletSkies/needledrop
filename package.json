{
  "name": "needledrop",
  "productName": "Needledrop",
  "version": "0.1.8",
  "description": "A 3D turntable music player for your desktop. Plays Spotify, Apple Music, YouTube and local files on a virtual record player.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5199 && cross-env VITE_DEV_SERVER_URL=http://localhost:5199 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --mac",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "app.needledrop",
    "productName": "Needledrop",
    "copyright": "MIT License",
    "directories": {
      "output": "release.noindex",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "darkModeSupport": true,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Needledrop reads what's playing in Spotify and Music so it can spin the record."
      },
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Needledrop",
      "iconSize": 110,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Needledrop-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "maintainer": "TheSscarletSkies <TheSscarletSkies@users.noreply.github.com>",
      "synopsis": "A 3D turntable music player"
    },
    "deb": {
      "depends": [
        "playerctl"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "TheSscarletSkies",
      "repo": "needledrop",
      "releaseType": "draft"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "m4a",
          "aac",
          "flac",
          "wav",
          "ogg",
          "opus",
          "aiff",
          "aif"
        ],
        "name": "Audio",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    }
  },
  "dependencies": {
    "music-metadata": "^12.3.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1",
    "three": "^0.187.0"
  },
  "author": "Mariyam Ahmed",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheSscarletSkies/needledrop.git"
  },
  "homepage": "https://github.com/TheSscarletSkies/needledrop"
}
